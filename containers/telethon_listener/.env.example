# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# ─── FastAPI Webhook ──────────────────────────────────────
FASTAPI_URL=http://fastapi:8000/api/v1/webhook/telegram

# ─── HMAC for request signing ─────────────────────────────
HMAC_SECRET=your-hmac-secret-min-32-characters

# ─── Channels to listen to (comma-separated) ──────────────
TELEGRAM_CHANNEL_IDS=-1001234567890,-1009876543210

# ─── Session persistence ──────────────────────────────────
SESSION_FILE=/app/sessions/session.session

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO