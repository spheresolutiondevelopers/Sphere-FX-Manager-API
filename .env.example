# ─── MS SQL Server ────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStrong!Password

# ─── FastAPI Database URL ───────────────────────────────────────────
DATABASE_URL=mssql+pyodbc://sa:YourStrong!Password@mssql:1433/nexus?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ─── gRPC addresses for Go workers ──────────────────────────────────
EXTRACTOR_GRPC_ADDR=extractor:50051
BACKTESTER_GRPC_ADDR=backtester:50052

# ─── MT5 Bridge (Windows VPS) ──────────────────────────────────────
MT5_BRIDGE_URL=http://windows-vps:8081

# ─── Authentication ──────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-bytes
LICENSE_KEY=ED25519_SIGNED_KEY

# ─── Telegram API ────────────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
HMAC_SECRET=your-hmac-secret-for-webhooks

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info